{
  "name": "filestation-webservice",
  "version": "0.1.0",
  "private": true,
  "description": "Private file transfer station web application",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build:shared": "npm run build --workspace=@filestation/shared",
    "build": "npm run build:shared && npm run build --workspace=@filestation/server && npm run build --workspace=@filestation/web",
    "dev": "npm run build:shared && cross-env FILESTATION_WEB_URL=http://localhost:5173 concurrently \"npm run dev --workspace=@filestation/server\" \"npm run dev --workspace=@filestation/web\"",
    "test": "npm run test --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "lint": "npm run lint --workspaces",
    "start": "cross-env FILESTATION_SERVE_STATIC=true FILESTATION_HOST=0.0.0.0 node apps/server/dist/main.js",
    "start:bynginx": "cross-env FILESTATION_SERVE_STATIC=false FILESTATION_HOST=127.0.0.1 node apps/server/dist/main.js"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "concurrently": "^9.0.0",
    "cross-env": "^10.1.0",
    "typescript": "^5.5.0"
  },
  "overrides": {
    "@nestjs/common@10.4.22": {
      "file-type": "20.5.0"
    },
    "@nestjs/config@3.3.0": {
      "lodash": "4.18.1"
    },
    "@nestjs/swagger@7.4.2": {
      "js-yaml": "4.3.2",
      "lodash": "4.18.1"
    },
    "@nestjs/platform-express@10.4.22": {
      "multer": "2.3.0"
    },
    "@nestjs/cli@10.4.9": {
      "glob": "11.1.0"
    },
    "@angular-devkit/core@17.3.11": {
      "picomatch": "4.0.4"
    },
    "external-editor@3.1.0": {
      "tmp": "0.2.7"
    },
    "@nestjs/serve-static@4.0.2": {
      "path-to-regexp": "1.9.0"
    },
    "express@4.22.1": {
      "path-to-regexp": "0.1.13"
    },
    "fdir@6.5.0": {
      "picomatch": "4.0.7"
    }
  },
  "engines": {
    "node": ">=20.17.0"
  }
}
